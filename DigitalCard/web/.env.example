# Supabase (local: `supabase status` in ../backend)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Public base URL used in QR codes / share links (no trailing slash)
VITE_PUBLIC_BASE_URL=http://localhost:5173
# Cloudflare Turnstile site key. Test key that always passes: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# true only for local demos: shows demo logins and the "open as guest" button. NEVER true in production.
VITE_DEMO_MODE=false
# true when Supabase Auth → Bot protection (Turnstile) is enabled: sign-up then sends a captcha token
VITE_AUTH_CAPTCHA=false
# Error reporting (optional, public value): Sentry project DSN. Empty = off. See docs/MONITORING.md
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
