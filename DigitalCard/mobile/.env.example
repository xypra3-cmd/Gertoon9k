# Copy to .env.local (never commit). Only EXPO_PUBLIC_* values reach the app bundle (they are public).
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Web origin that serves /c/<slug>
EXPO_PUBLIC_WEB_URL=http://10.0.2.2:5173
EXPO_PUBLIC_DOMAIN=digitalcard.mn
# Error reporting (optional, public value): Sentry project DSN. Empty = off. See docs/MONITORING.md
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
