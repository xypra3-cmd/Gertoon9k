# Copy to supabase/.env for local development. NEVER commit the real file.
# In production set these with: supabase secrets set --env-file ./supabase/.env
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# Long random string; used to derive the daily salt for visitor_hash
STATS_SALT_SECRET=
# Cloudflare Turnstile secret. Test secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=
# Override only for local tests (mock server); production uses Cloudflare's default URL
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# Public base URL of the functions (used to build the QPay callback_url)
PUBLIC_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1
# Shared secret that cron jobs send in the x-cron-secret header
CRON_SECRET=
# Claude API key for the ai-assist function (Edge Function secret only, never in the apps)
ANTHROPIC_API_KEY=
# Leave empty in production (SDK default). Local tests point it at the mock server.
ANTHROPIC_BASE_URL=
# Error reporting (optional; empty = off). Sentry project DSN — enable «Prevent Storing of IP Addresses»
# in the Sentry project (docs/MONITORING.md). Local tests point it at the mock server.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Public site URL (QR links inside Wallet passes)
PUBLIC_WEB_URL=http://localhost:5173
# Apple Wallet: Pass Type ID certificate from developer.apple.com (base64 of the PEM files, one line each).
# Local dev: scripts/dev-wallet-certs.sh fills these with a self-signed test chain (iPhone will not accept it).
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_B64=
APPLE_PASS_KEY_B64=
APPLE_PASS_KEY_PASSWORD=
APPLE_WWDR_CERT_B64=
# Google Wallet: issuer id + service account (Wallet API) private key, base64 of the PEM
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_KEY_B64=
